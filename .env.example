# Copiar a .env y rellenar. Nunca comitear .env.

# Modo de operación: simulation (único valor permitido en fases 0-10)
QTRADER_MODE=simulation

# Credenciales broker paper (IBKR paper account) — vacías en fase 0
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Ruta al fichero HALT (propiedad de otro usuario del sistema)
HALT_FILE_PATH=/var/run/qtrader/HALT

# Logging
LOG_LEVEL=INFO
